#!/bin/bash
# Cursor sessionStart：把本技能的绑定注入当前会话。不依赖用户说出触发词。
# 输出只写 additional_context。失败时仍吐出一行说明，避免空输出。

case "$0" in
  */*|*\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
SKILL_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

repo=""
if git_root="$(git -C "${PWD}" rev-parse --show-toplevel 2>/dev/null)"; then
  repo="$git_root"
elif git_root="$(git -C "${SKILL_ROOT}" rev-parse --show-toplevel 2>/dev/null)"; then
  repo="$git_root"
fi

next=""
err=""
if [ -n "$repo" ]; then
  if ! next="$("${SKILL_ROOT}/scripts/workflow_next.py" next --repo "$repo" 2>"${TMPDIR:-/tmp}/data-workflow-next.err")"; then
    err="$(cat "${TMPDIR:-/tmp}/data-workflow-next.err" 2>/dev/null || true)"
  fi
else
  err="找不到 git 根，没有读取 specs/*/run.json"
fi

text=""
first="$(printf '%s\n' "$next" | head -n 1)"
case "$first" in
  LAST|LAST\ *|NO_RUN|NO_RUN\ *|"")
    text=""
    ;;
  *)
    text="$next"
    ;;
esac
if [ -n "$err" ]; then
  text="${text}
workflow_next 失败：${err}"
fi

printf '{\n  "additional_context": "%s"\n}\n' "$(escape_for_json "$text")"
