#!/bin/bash
# Cursor sessionStart：把本技能的绑定注入当前会话。不依赖用户说出触发词。
# 输出只写 additional_context。失败时仍吐出一行说明，避免空输出。

case "$0" in
  */*|*\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
SKILL_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

repo=""
if git_root="$(git -C "${PWD}" rev-parse --show-toplevel 2>/dev/null)"; then
  repo="$git_root"
elif git_root="$(git -C "${SKILL_ROOT}" rev-parse --show-toplevel 2>/dev/null)"; then
  repo="$git_root"
fi

next=""
err=""
if [ -n "$repo" ]; then
  if ! next="$("${SKILL_ROOT}/scripts/workflow_next.py" next --repo "$repo" 2>"${TMPDIR:-/tmp}/data-workflow-next.err")"; then
    err="$(cat "${TMPDIR:-/tmp}/data-workflow-next.err" 2>/dev/null || true)"
  fi
else
  err="找不到 git 根，没有读取 specs/*/run.json"
fi

usage="用法就这几条。记录在当前 git 根的 specs/<feature>/run.json，不是 config.yaml 的 repo，也不是上一场聊天。
next：看现在该做什么。
start <workflow> <feature>：新开一次。没有 data-service 门禁时用 change。
wait <feature> \"问题\" \"对方能原样粘贴的一句\"：要问人时写下来并停止。
answer <feature> \"对方的原话\"：对上了才继续。
done <feature>：这一阶段做完。
输出里有 RUN、NEED、WAIT、DO、OPEN 时，只做那一件。LAST 表示上次已经做完，记录还在 RECORD 那个文件里。不要从 SKILL.md 步骤 0 重开。
写入门在 ${SKILL_ROOT}/references/edit-gate.md。protected_paths 和 waiver_globs 都没写时，仍拦 api/、proto、pb.go、status.go 和其它 *.go。"

text="${next}"
if [ -n "$err" ]; then
  text="${text}
workflow_next 失败：${err}"
fi
text="${text}

${usage}"

printf '{\n  "additional_context": "%s"\n}\n' "$(escape_for_json "$text")"
