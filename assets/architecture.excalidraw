      "text": "永不上抄 —— 技能与知识层只放指针",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "永不上抄 —— 技能与知识层只放指针",
      "lineHeight": 1.3
    },
    {
      "id": "text_91_38cudc",
      "type": "text",
      "x": 50,
      "y": 1447,
      "width": 1020,
      "height": 24,
      "angle": 0,
